{
  "name": "voltforge-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run test:bundle-budget",
    "lint": "oxlint",
    "test": "tsc -b && oxlint && npm run test:worker-protocol && npm run test:result-subscription && npm run test:runtime-delta && npm run test:model-revision && npm run test:mna-incremental && npm run test:scope-capture && npm run test:canvas-render && npm run test:avr-budget",
    "test:worker-protocol": "node scripts/run-worker-backpressure-tests.mjs",
    "test:result-subscription": "node scripts/run-result-subscription-tests.mjs",
    "test:runtime-delta": "node scripts/run-runtime-delta-tests.mjs",
    "test:model-revision": "node scripts/run-model-revision-tests.mjs",
    "test:mna-incremental": "node scripts/run-mna-incremental-tests.mjs",
    "test:scope-capture": "node scripts/run-scope-capture-tests.mjs",
    "test:canvas-render": "node scripts/run-canvas-render-tests.mjs",
    "test:avr-budget": "node scripts/run-avr-execution-budget-tests.mjs",
    "test:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview"
  },

  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.101.2",
    "avr8js": "^0.21.0",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "keycloak-js": "^26.2.4",
    "konva": "^10.3.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-konva": "^19.2.5",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
